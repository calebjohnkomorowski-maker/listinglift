# Copy this file to .env.local and fill in your key.
#   cp .env.example .env.local

# Required. Get one at https://console.anthropic.com/settings/keys
# Server-side only: it is never sent to the browser.
ANTHROPIC_API_KEY=

# Optional. Claude model to use (default: claude-sonnet-5-5). Needs a Claude 4.6+ model.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Reasoning effort: low | medium | high | xhigh | max (default: medium).
# Lower is faster and cheaper; medium is plenty for marketing copy.
ANTHROPIC_EFFORT=medium

# Optional. Demo rate limits (in-memory, per server instance).
RATE_LIMIT_PER_IP=10
RATE_LIMIT_WINDOW_MINUTES=10
DAILY_GENERATION_CAP=300

# Optional. Set to 1 to return template-based copy without calling the API.
# Handy for UI work or demos without a key.
LISTINGLIFT_MOCK=0
